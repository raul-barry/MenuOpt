# Configuración general de MenuOpt
PROJECT_NAME="MenuOpt API"
PROJECT_VERSION="1.0.0"

# Base de datos PostgreSQL
POSTGRES_DB=menuopt_db
POSTGRES_USER=menuopt
POSTGRES_PASSWORD=menuopt_dev_password_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Seguridad JWT
JWT_SECRET_KEY=menuopt_jwt_secret_key_development_only_2026_super_secure_random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Asistencia con Inteligencia Artificial (CU26)
AI_ENABLED=true
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=15

# Cloudflare Tunnel (Pruebas remotas APK en 4G/WiFi externo sin VPN ni abrir puertos)
# Token obtenido desde Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
